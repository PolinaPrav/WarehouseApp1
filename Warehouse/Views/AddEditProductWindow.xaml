<Window x:Class="Warehouse.Views.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Warehouse.Views"
        mc:Ignorable="d"
        Title="Товар" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Наименование:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Категория:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCategory" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Производитель:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtManufacturer" Grid.Row="2" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Поставщик:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSupplier" Grid.Row="3" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Цена:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPrice" Grid.Row="4" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Остаток:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtStock" Grid.Row="5" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Скидка %:" Grid.Row="6" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <TextBox x:Name="txtDiscount" Grid.Row="6" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Фото:" Grid.Row="7" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="5">
                <TextBox x:Name="txtImagePath" Width="200" Margin="0,0,5,0" IsReadOnly="True"/>
                <Button Content="Обзор..." Click="SelectImage_Click" Width="70"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,20,5,5">
                <Button Content="OK" Width="80" Margin="5" Click="Ok_Click"/>
                <Button Content="Отмена" Width="80" Margin="5" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
