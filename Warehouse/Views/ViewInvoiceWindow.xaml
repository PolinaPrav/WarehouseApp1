<Window x:Class="Warehouse.Views.ViewInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр накладной" Height="450" Width="650"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="txtHeader" FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="txtDate" Margin="0,5,0,0"/>
            <TextBlock x:Name="txtType" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid x:Name="gridItems"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="200"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button DockPanel.Dock="Bottom" Content="Закрыть" Width="100"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="Close_Click"/>
    </DockPanel>
</Window>