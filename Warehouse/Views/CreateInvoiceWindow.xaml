<Window x:Class="Warehouse.Views.CreateInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Warehouse.Views"
        mc:Ignorable="d"
        Title="Накладная" Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Тип накладной:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock x:Name="txtType" Margin="0,0,0,15" FontSize="14" Foreground="DarkBlue"/>

        <TextBlock Text="Выберите товар:" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbProducts" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,15" Height="25"/>

        <TextBlock Text="Количество:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtQuantity" Text="1" Margin="0,0,0,15" Width="150" HorizontalAlignment="Left"/>

        <TextBlock Text="Цена за единицу (на момент накладной):" Margin="0,0,0,5"/>
        <TextBox x:Name="txtUnitPrice" Margin="0,0,0,15" Width="150" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Создать накладную" Width="140" Margin="5" Click="Create_Click"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>