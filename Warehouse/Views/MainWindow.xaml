<Window x:Class="Warehouse.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организации" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Организации" Margin="0,0,0,5"/>

        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding Organizations}"
                 SelectedItem="{Binding SelectedOrganization}"
                 DisplayMemberPath="Name">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Новая организация" Command="{Binding AddOrgCommand}"/>
                    <MenuItem Header="Изменить организацию" Command="{Binding EditOrgCommand}"/>
                    <MenuItem Header="Удалить организацию" Command="{Binding DeleteOrgCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Button Content="OK" Height="30" Margin="0,0,0,10"
                    Command="{Binding OpenWarehouseCommand}"/>
            <Button Content="Закрыть" Height="30" Click="Close_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding SelectedOrganization.Name}"
                   Background="LightGray" Padding="5" Margin="0,10,0,0"/>
    </Grid>
</Window>