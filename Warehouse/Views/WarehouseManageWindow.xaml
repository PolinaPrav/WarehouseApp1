<Window x:Class="Warehouse.Views.WarehouseManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding CurrentOrganization.Name}" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Закрыть" Click="Close_Click"/>
            </MenuItem>

            <MenuItem Header="Склады">
                <MenuItem Header="Новый склад" Command="{Binding AddWarehouseCommand}"/>
                <MenuItem Header="Изменить склад" Command="{Binding EditWarehouseCommand}"/>
                <MenuItem Header="Удалить склад" Command="{Binding DeleteWarehouseCommand}"/>
                <MenuItem Header="Импорт товаров" Click="ImportProducts_Click"/>
            </MenuItem>

            <MenuItem Header="Товары">
                <MenuItem Header="Новый товар" Command="{Binding AddProductCommand}"/>
                <MenuItem Header="Изменить товар" Command="{Binding EditProductCommand}"/>
                <MenuItem Header="Удалить товар" Command="{Binding DeleteProductCommand}"/>
            </MenuItem>

            <MenuItem Header="Накладные">
                <MenuItem Header="Просмотреть накладную" Command="{Binding ViewInvoiceCommand}"/>
                <MenuItem Header="Создать накладную (приход)" Command="{Binding CreateIncomingInvoiceCommand}"/>
                <MenuItem Header="Создать накладную (расход)" Command="{Binding CreateOutgoingInvoiceCommand}"/>
                <MenuItem Header="Удалить накладную" Command="{Binding DeleteInvoiceCommand}"/>
            </MenuItem>

            <MenuItem Header="Сохранения">
                <MenuItem Header="Сохранить в JSON" Click="SaveJson_Click"/>
                <MenuItem Header="Загрузить из JSON" Click="LoadJson_Click"/>
                <MenuItem Header="Экспорт товаров в PDF" Click="ExportProductsPdf_Click"/>
                <MenuItem Header="Экспорт накладных в PDF" Click="ExportInvoicesPdf_Click"/>
                <MenuItem Header="Очистить все данные" Click="ClearAll_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding CurrentOrganization.Name}"/>
        </StatusBar>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Склады" FontWeight="Bold" Margin="5"/>
                    <ListBox ItemsSource="{Binding Warehouses}"
                             SelectedItem="{Binding SelectedWarehouse}"
                             DisplayMemberPath="Name"
                             Height="480">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Новый склад" Command="{Binding AddWarehouseCommand}"/>
                                <MenuItem Header="Изменить склад" Command="{Binding EditWarehouseCommand}"/>
                                <MenuItem Header="Удалить склад" Command="{Binding DeleteWarehouseCommand}"/>
                                <MenuItem Header="Импорт товаров" Click="ImportProducts_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </StackPanel>
            </Border>

            <TabControl Grid.Column="1" Margin="5,0,0,0">

                <TabItem Header="Товары">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="250"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Новый товар" Command="{Binding AddProductCommand}"/>
                                    <MenuItem Header="Изменить товар" Command="{Binding EditProductCommand}"/>
                                    <MenuItem Header="Удалить товар" Command="{Binding DeleteProductCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Фото" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding ImagePath}" Width="50" Height="50" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="120"/>
                                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="120"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="80"/>
                                <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="70"/>
                                <DataGridTextColumn Header="Скидка %" Binding="{Binding DiscountPercent}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Накладные">
                    <DataGrid ItemsSource="{Binding Invoices}"
                              SelectedItem="{Binding SelectedInvoice}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              MouseDoubleClick="InvoicesGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Просмотреть накладную" Command="{Binding ViewInvoiceCommand}"/>
                                <MenuItem Header="Создать накладную (приход)" Command="{Binding CreateIncomingInvoiceCommand}"/>
                                <MenuItem Header="Создать накладную (расход)" Command="{Binding CreateOutgoingInvoiceCommand}"/>
                                <MenuItem Header="Удалить накладную" Command="{Binding DeleteInvoiceCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:g}}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Сохранения">
                    <StackPanel Margin="20">
                        <TextBlock Text="Сохранение и экспорт данных"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <Button Content="Сохранить в JSON" Width="220" Height="30"
                                HorizontalAlignment="Left" Margin="0,5"
                                Click="SaveJson_Click"/>

                        <Button Content="Загрузить из JSON" Width="220" Height="30"
                                HorizontalAlignment="Left" Margin="0,5"
                                Click="LoadJson_Click"/>

                        <Button Content="Экспорт товаров в PDF" Width="220" Height="30"
                                HorizontalAlignment="Left" Margin="0,15,0,5"
                                Click="ExportProductsPdf_Click"/>

                        <Button Content="Экспорт накладных в PDF" Width="220" Height="30"
                                HorizontalAlignment="Left" Margin="0,5"
                                Click="ExportInvoicesPdf_Click"/>

                        <Button Content="Очистить все данные" Width="220" Height="30"
                                HorizontalAlignment="Left" Margin="0,15,0,5"
                                Click="ClearAll_Click"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</Window>